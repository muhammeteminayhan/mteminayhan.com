---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { gallery } from '@/data/gallery';
import type { Lang } from '@/i18n/ui';
import { useT } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const items = await Promise.all(
  gallery.map(async (g) => ({ ...g, full: (await getImage({ src: g.src, width: 1600, format: 'webp' })).src })),
);
// bento layout: first image is the tall hero tile
const spans = ['sm:row-span-2', '', '', 'sm:col-span-2 lg:col-span-1', ''];
---

<section id="gallery" class="py-20 sm:py-28" aria-labelledby="gallery-title">
  <div class="container-page">
    <SectionHeading id="gallery-title" eyebrow={t('gallery.eyebrow')} title={t('gallery.title')} />
    <ul class="grid auto-rows-[15rem] grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((g, i) => (
          <li class:list={['reveal', spans[i] ?? '']} style={`--d:${i * 70}ms`}>
            <button
              type="button"
              class="group relative block size-full overflow-hidden rounded-2xl border border-line bg-surface text-left"
              data-lightbox-open
              data-full={g.full}
              data-alt={g.alt[lang]}
              data-caption={g.caption[lang]}
            >
              <Image
                src={g.src}
                alt={g.alt[lang]}
                widths={[400, 700, 1000]}
                sizes="(min-width: 1024px) 24rem, (min-width: 640px) 50vw, 100vw"
                class="size-full object-cover transition duration-700 group-hover:scale-105"
              />
              <span class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-2 bg-gradient-to-t from-black/85 via-black/40 to-transparent p-4 pt-12 text-sm text-white">
                <span>{g.caption[lang]}</span>
                <Icon name="zoom" size={18} class="shrink-0 opacity-0 transition group-hover:opacity-100" />
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog
    data-lightbox
    class="m-auto max-h-[92vh] max-w-[min(92vw,1100px)] overflow-visible bg-transparent p-0 backdrop:bg-black/85 backdrop:backdrop-blur-sm"
  >
    <figure class="relative">
      <img src="" alt="" class="max-h-[82vh] w-auto rounded-xl object-contain" />
      <figcaption class="mt-3 text-center text-sm text-white/80" data-lightbox-caption></figcaption>
      <button
        type="button"
        data-lightbox-close
        class="absolute -top-3 -right-3 grid size-10 place-items-center rounded-full bg-white text-black shadow-lg"
        aria-label={t('gallery.close')}><Icon name="x" size={18} /></button
      >
    </figure>
  </dialog>
</section>
