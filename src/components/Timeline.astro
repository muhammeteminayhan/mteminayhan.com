---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { education, work, type TimelineItem } from '@/data/experience';
import type { Lang } from '@/i18n/ui';
import { useT } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const columns: { title: string; icon: string; items: TimelineItem[] }[] = [
  { title: t('exp.work'), icon: 'briefcase', items: work },
  { title: t('exp.education'), icon: 'cap', items: education },
];
---

<section id="experience" class="border-t border-line bg-bg-soft/40 py-20 sm:py-28" aria-labelledby="exp-title">
  <div class="container-page">
    <SectionHeading id="exp-title" eyebrow={t('exp.eyebrow')} title={t('exp.title')} />

    <div class="grid gap-12 lg:grid-cols-2 lg:gap-10">
      {
        columns.map((col) => (
          <div>
            <h3 class="reveal mb-6 flex items-center gap-2.5 text-sm font-semibold tracking-wide text-muted uppercase">
              <Icon name={col.icon} size={18} class="text-accent" />
              {col.title}
            </h3>
            <ol class="timeline relative space-y-6 pl-7">
              {col.items.map((item, i) => (
                <li class="reveal relative" style={`--d:${i * 100}ms`}>
                  <span
                    class:list={[
                      'absolute top-1.5 -left-7 grid size-[15px] place-items-center rounded-full border-2 bg-bg',
                      item.end ? 'border-line-strong' : 'border-accent',
                    ]}
                    aria-hidden="true"
                  >
                    {!item.end && <span class="size-1.5 rounded-full bg-accent" />}
                  </span>
                  <div class="card p-5">
                    <p class="font-mono text-xs text-faint">
                      {item.start[lang]}
                      {item.end ? (item.end[lang] !== item.start[lang] ? ` — ${item.end[lang]}` : '') : ` — ${t('exp.present')}`}
                    </p>
                    <h4 class="mt-1.5 font-semibold">{item.title[lang]}</h4>
                    <p class="text-sm text-accent">
                      {typeof item.org === 'string' ? item.org : item.org[lang]}
                      <span class="text-faint"> · {item.place[lang]}</span>
                    </p>
                    {item.points && (
                      <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
                        {item.points.map((pt) => (
                          <li class="flex gap-2.5">
                            <span class="mt-2 size-1 shrink-0 rounded-full bg-faint" aria-hidden="true" />
                            <span>{pt[lang]}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                    {item.tags && (
                      <ul class="mt-4 flex flex-wrap gap-1.5">
                        {item.tags.map((tag) => (
                          <li class="chip">{tag}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 1px;
    background: linear-gradient(to bottom, var(--accent), var(--border) 40%, transparent);
    transform-origin: top;
  }
  :global(.js) .timeline::before {
    transform: scaleY(0);
    transition: transform 1.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(.js) .timeline:has(> li.is-visible)::before {
    transform: scaleY(1);
  }
</style>
