---
/** Generated cover for projects without an image: a small category-specific illustration + glyph. */
import type { Category } from '@/data/projects';

interface Props {
  category: Category;
  glyph: string;
  art?: 'slalom';
}
const { category, glyph, art } = Astro.props;

const tint: Record<Category, string> = {
  robotics: 'var(--accent)',
  cv: '#38bdf8',
  ml: '#34d399',
  software: '#a78bfa',
};
const c = tint[category];
---

<div class="relative size-full overflow-hidden bg-surface-2">
  <div class="bg-grid absolute inset-0 opacity-80" aria-hidden="true"></div>
  <div
    class="absolute inset-0"
    style={`background: radial-gradient(120% 90% at 85% 0%, color-mix(in srgb, ${c} 22%, transparent), transparent 60%);`}
    aria-hidden="true"
  >
  </div>
  <svg viewBox="0 0 400 200" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 size-full transition duration-700 group-hover:scale-105" aria-hidden="true">
    {
      category === 'robotics' && art !== 'slalom' && (
        <g fill="none" stroke-linecap="round">
          <path d="M30 170 C 90 150, 110 60, 180 70 S 290 150, 370 40" stroke="var(--fg)" stroke-opacity=".35" stroke-width="2" />
          <path d="M30 170 C 92 146, 118 70, 186 78 S 300 146, 372 58" stroke={c} stroke-width="2.2" stroke-dasharray="6 6" />
          {[
            [30, 170],
            [98, 128],
            [186, 78],
            [262, 112],
            [330, 88],
          ].map(([x, y]) => (
            <g transform={`translate(${x} ${y})`}>
              <circle r="9" fill={c} fill-opacity=".12" />
              <path d="M-5 4 L0 -6 L5 4 Z" fill={c} />
            </g>
          ))}
          <circle cx="372" cy="58" r="4" fill={c} />
        </g>
      )
    }
    {
      art === 'slalom' && (
        <g fill="none" stroke-linecap="round">
          <path d="M20 150 C 70 150, 80 60, 130 60 S 190 150, 240 150 S 300 60, 350 60 L 390 60" stroke={c} stroke-width="2.2" stroke-dasharray="7 6" />
          {[
            [105, 118],
            [185, 92],
            [265, 118],
            [345, 92],
          ].map(([x, y]) => (
            <g transform={`translate(${x} ${y})`}>
              <path d="M-9 12 L0 -12 L9 12 Z" fill={c} fill-opacity=".9" />
              <path d="M-6 4 h12" stroke="var(--surface)" stroke-width="3" />
            </g>
          ))}
          <g transform="translate(20 150)">
            <rect x="-14" y="-10" width="28" height="20" rx="5" fill="var(--fg)" fill-opacity=".85" />
            <circle cx="-8" cy="12" r="4" fill="var(--fg)" fill-opacity=".5" />
            <circle cx="8" cy="12" r="4" fill="var(--fg)" fill-opacity=".5" />
          </g>
          <circle cx="60" cy="40" r="46" stroke="var(--fg)" stroke-opacity=".12" />
          <circle cx="60" cy="40" r="26" stroke="var(--fg)" stroke-opacity=".12" />
        </g>
      )
    }
    {
      category === 'cv' && (
        <g fill="none" font-family="monospace" font-size="9">
          <rect x="40" y="46" width="120" height="96" rx="4" stroke={c} stroke-width="2" />
          <rect x="40" y="34" width="68" height="13" fill={c} />
          <text x="44" y="44" fill="#0b1020">vehicle 0.97</text>
          <rect x="210" y="70" width="80" height="84" rx="4" stroke="var(--fg)" stroke-opacity=".5" stroke-width="1.6" />
          <rect x="300" y="40" width="64" height="60" rx="4" stroke={c} stroke-width="1.6" stroke-dasharray="4 4" />
          <path d="M60 120 h80 M70 100 h60" stroke="var(--fg)" stroke-opacity=".2" stroke-width="10" stroke-linecap="round" />
          <circle cx="250" cy="100" r="10" stroke="var(--fg)" stroke-opacity=".35" />
          <path d="M235 130 q15 -14 30 0" stroke="var(--fg)" stroke-opacity=".35" />
        </g>
      )
    }
    {
      category === 'ml' && (
        <g>
          {[62, 96, 80, 124, 108, 140, 132, 150].map((h, i) => (
            <rect x={48 + i * 40} y={180 - h} width="22" height={h} rx="3" fill={i === 5 ? c : 'var(--fg)'} fill-opacity={i === 5 ? 0.9 : 0.14} />
          ))}
          <path d="M40 150 C 120 120, 200 70, 370 40" fill="none" stroke={c} stroke-width="2" stroke-dasharray="5 5" />
        </g>
      )
    }
    {
      category === 'software' && (
        <g fill="none">
          <rect x="150" y="18" width="100" height="176" rx="16" stroke="var(--fg)" stroke-opacity=".45" stroke-width="2" />
          <rect x="162" y="40" width="76" height="30" rx="6" fill={c} fill-opacity=".85" />
          <rect x="162" y="78" width="76" height="12" rx="4" fill="var(--fg)" fill-opacity=".15" />
          <rect x="162" y="96" width="56" height="12" rx="4" fill="var(--fg)" fill-opacity=".15" />
          <rect x="162" y="118" width="36" height="36" rx="6" fill="var(--fg)" fill-opacity=".1" />
          <rect x="202" y="118" width="36" height="36" rx="6" fill={c} fill-opacity=".25" />
          <path d="M60 60 l-22 22 22 22 M340 60 l22 22 -22 22" stroke={c} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      )
    }
  </svg>
  <span class="absolute right-4 bottom-3 font-mono text-3xl font-bold tracking-tight text-fg/85 sm:text-4xl">{glyph}</span>
</div>
