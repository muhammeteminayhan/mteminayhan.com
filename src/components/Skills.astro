---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { skillGroups } from '@/data/skills';
import type { Lang } from '@/i18n/ui';
import { useT } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section id="skills" class="border-t border-line bg-bg-soft/40 py-20 sm:py-28" aria-labelledby="skills-title">
  <div class="container-page">
    <SectionHeading id="skills-title" eyebrow={t('skills.eyebrow')} title={t('skills.title')} />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        skillGroups.map((g, i) => (
          <div class="reveal card p-5" style={`--d:${(i % 4) * 70}ms`}>
            <h3 class="mb-4 flex items-center gap-2.5 font-semibold">
              <span class="grid size-8 place-items-center rounded-lg bg-accent-soft text-accent">
                <Icon name={g.icon} size={17} />
              </span>
              {g.title[lang]}
            </h3>
            <ul class="flex flex-wrap gap-1.5">
              {g.items.map((s) => (
                <li class="chip transition hover:border-accent/50 hover:text-fg">{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
