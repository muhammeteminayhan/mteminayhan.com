---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import type { Lang } from '@/i18n/ui';
import { useT } from '@/i18n/utils';
import { getPosts } from '@/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const posts = await getPosts(lang);
---

<BaseLayout lang={lang} title={t('blog.title')} description={t('blog.lead')}>
  <section class="relative isolate overflow-hidden pt-32 pb-20 sm:pt-40">
    <div class="bg-grid absolute inset-x-0 top-0 -z-10 h-[28rem] [mask-image:linear-gradient(to_bottom,black,transparent)]" aria-hidden="true"></div>
    <div class="container-page">
      <SectionHeading as="h1" eyebrow={t('blog.eyebrow')} title={t('blog.title')} lead={t('blog.lead')} />
      <div class="grid max-w-3xl gap-6">
        {posts.map((post, i) => <PostCard post={post} lang={lang} delay={i * 70} />)}
      </div>
    </div>
  </section>
</BaseLayout>
